---
/**
 * UsecasesTagView — a usecases tag archive page.
 *
 * Shared body for the default-locale route (`/usecases/tag/<tag>`) and the
 * locale-prefixed route (`/<locale>/usecases/tag/<tag>`). The matching usecases
 * and the visible tag cloud are resolved in each route's `getStaticPaths` and
 * passed in; URLs are built locale-aware via `lib/usecases`.
 */
import type { CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import UsecaseCard from '@/components/usecases/UsecaseCard.astro';
import UsecaseTagList from '@/components/usecases/UsecaseTagList.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import { t, defaultLocale } from '@/i18n';
import { getUsecasesBaseUrl } from '@/lib/usecases';

interface Props {
  /** Locale whose usecases this archive renders. Defaults to the site default. */
  locale?: string;
  /** The active tag (display form). */
  tag: string;
  /** Usecases carrying this tag, in the locale. */
  usecases: CollectionEntry<'usecases'>[];
  /** Tags to render in the cloud (always includes the active tag). */
  visibleTags: string[];
}

const { locale = defaultLocale, tag, usecases, visibleTags } = Astro.props;

const usecasesHref = getUsecasesBaseUrl(locale);
const countKey = usecases.length === 1 ? 'usecases.tagCountOne' : 'usecases.tagCountOther';
---

<PageLayout
  title={t('usecases.tagMetaTitle', locale, { tag })}
  description={t('usecases.tagMetaDescription', locale, { tag })}
  eagerReveal
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="tag" size="sm" />
      {t('usecases.tagBadge', locale)}
    </Badge>

    <h1
      slot="title"
      class="!text-4xl sm:!text-5xl md:!text-6xl lg:!text-7xl break-words [overflow-wrap:anywhere]"
    >#{tag}</h1>

    <p slot="description">
      {t(countKey, locale, { count: usecases.length, tag })}
    </p>
  </Hero>

  <section class="bg-background-secondary py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        <a
          href={usecasesHref}
          class="group inline-flex items-center gap-2 rounded-lg border border-brand-500/40 bg-transparent px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 hover:border-brand-500/80 hover:bg-brand-500/10 transition-colors"
        >
          <Icon name="arrow-left" size="sm" />
          {t('usecases.allUsecases', locale)}
        </a>

        {visibleTags.length > 0 && (
                        <UsecaseTagList tags={visibleTags} active={tag} locale={locale} class="justify-center" />
        )}
      </div>

      {usecases.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {usecases.map((usecase, i) => (
                          <UsecaseCard usecase={usecase} index={i} locale={locale} />
          ))}
        </div>
      ) : (
        <div class="py-16 text-center">
          <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
            <Icon name="layers" size="lg" class="text-foreground-muted" />
          </div>
          <p class="text-foreground-muted text-lg">{t('usecases.tagEmpty', locale)}</p>
          <div class="mt-6">
            <Button href={usecasesHref} variant="brand-outline" size="sm">
              <Icon name="arrow-left" size="sm" />
              {t('usecases.tagBackToAll', locale)}
            </Button>
          </div>
        </div>
      )}
    </div>
  </section>
</PageLayout>
