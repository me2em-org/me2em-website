---
/**
 * UsecasesPageView — a paginated usecases index page (page 2..N).
 *
 * Shared body for the default-locale route (`/usecases/page/N`) and the
 * locale-prefixed route (`/<locale>/usecases/page/N`). The page number and
 * total are resolved in each route's `getStaticPaths` and passed in; URLs are
 * built locale-aware via `lib/usecases`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import CtaBand from '@/components/patterns/CtaBand.astro';
import UsecaseCard from '@/components/usecases/UsecaseCard.astro';
import UsecaseTagList from '@/components/usecases/UsecaseTagList.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { t, defaultLocale, localizedPath } from '@/i18n';
import {
  collectTopUsecaseTags,
  getUsecasesBaseUrl,
  getUsecasesPageUrl,
  getVisibleUsecases,
  PROJECT_TAG_CLOUD_LIMIT,
  PROJECTS_PER_PAGE,
} from '@/lib/usecases';

interface Props {
  /** Locale whose usecases this page renders. Defaults to the site default. */
  locale?: string;
  /** 1-based page number (always >= 2 for this view). */
  page: number;
  /** Total number of index pages for this locale. */
  totalPages: number;
}

const { locale = defaultLocale, page, totalPages } = Astro.props;

const usecases = await getVisibleUsecases(locale);
const start = (page - 1) * PROJECTS_PER_PAGE;
const pageUsecases = usecases.slice(start, start + PROJECTS_PER_PAGE);

const topTags = collectTopUsecaseTags(usecases, PROJECT_TAG_CLOUD_LIMIT);

const usecasesHref = getUsecasesBaseUrl(locale);
const contactUrl = localizedPath('/contact', locale);
const aboutUrl = localizedPath('/about', locale);
---

<PageLayout
  title={t('usecases.pageMetaTitle', locale, { page })}
  description={t('usecases.pageMetaDescription', locale, { page, total: totalPages })}
  eagerReveal
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      {t('usecases.pageBadge', locale, { page, total: totalPages })}
    </Badge>

    <h1 slot="title">{t('usecases.title', locale)}</h1>

    <p slot="description">
      {t('usecases.heroDescription', locale)}
    </p>
  </Hero>

  <section class="bg-background-secondary py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        <a
          href={usecasesHref}
          class="group inline-flex items-center gap-2 rounded-lg border border-brand-500/40 bg-transparent px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 hover:border-brand-500/80 hover:bg-brand-500/10 transition-colors"
        >
          <Icon name="arrow-left" size="sm" />
          {t('usecases.allUsecases', locale)}
        </a>

        {topTags.length > 0 && (
                      <UsecaseTagList tags={topTags} locale={locale} class="justify-center" />
        )}
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {pageUsecases.map((usecase, i) => (
                      <UsecaseCard usecase={usecase} index={i} locale={locale} />
        ))}
      </div>

      <Pagination
        currentPage={page}
        totalPages={totalPages}
          href={(p) => getUsecasesPageUrl(p, locale)}
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('usecases.ctaHeading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('usecases.ctaLead', locale)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl}>
          {t('usecases.ctaPrimary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={aboutUrl}>
          {t('usecases.ctaSecondary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </CtaBand>
  </section>
</PageLayout>
