---
/**
 * Usecase listing card. Extracted so the usecases index, paginated pages,
 * and tag archives render identical cards from one source of truth.
 *
 * Placeholder usecases render as a non-interactive card (no link), matching
 * how the listing treats usecases that don't have their own detail page.
 */
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { defaultLocale } from '@/i18n';
import { getUsecaseUrl } from '@/lib/usecases';

interface Props {
  usecase: CollectionEntry<'usecases'>;
  /** Stagger index for the scroll-reveal cascade. */
  index?: number;
  /**
    * Locale the card's link belongs to. Default-locale links stay at
    * `/usecases/...`; other locales are prefixed (`/<locale>/usecases/...`).
    */
  locale?: string;
  /**
   * Add the scroll-reveal trigger. Turn it off where a parent already reveals
   * the whole section — nesting one reveal inside another leaves the cards
   * waiting on a trigger that has already fired.
   */
  reveal?: boolean;
}

const { usecase, index = 0, locale = defaultLocale, reveal = true } = Astro.props;
const { data } = usecase;
---

<Card
  variant="elevated"
  hover
  padding="none"
  href={data.placeholder ? undefined : getUsecaseUrl(usecase.id, locale)}
  class="group flex flex-col"
  data-reveal={reveal || undefined}
  data-reveal-delay={reveal ? index % 2 || undefined : undefined}
>
  <!--
    Bottom padding is larger than the rest on purpose. Above the icon sits the
    padding plus the UC row and its margin — 54px from the border to the top
    of the icon — while below the tags there is only the padding. 53px puts the
    same 54px under the tags, so the card reads as evenly weighted.

    It is a measured value rather than a scale step, because it mirrors the
    UC row, whose height comes from its font size. If that row changes, this
    wants re-measuring: border to top of icon, and bottom of the tag pills to
    border.
  -->
  <div class="flex flex-1 flex-col p-6 pb-[53px]">
    <!-- The UC code and the arrow square off the top corners, leaving the middle
         of the card to the project itself. -->
    <div class="mb-3 flex items-start justify-between gap-4">
      {data.uc ? (
        <span class="text-xs text-foreground-muted">{data.uc}</span>
      ) : (
        <span />
      )}
      <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
    </div>

    <!--
      The usecase's own icon, from its frontmatter, falling back to `layers`.
      One repeated icon across every card makes them read as placeholders, so
      each usecase carries its own.

      A plain 40px icon rather than one inside a gradient tile, matching every
      other card in the theme. The size only works centred: left-aligned in a
      corner it has nothing to balance against and towers over the title.
    -->
    <div class="mb-3 flex flex-col items-center gap-2 text-center">
      <Icon name={data.icon ?? 'layers'} class="w-10 h-10 text-brand-500 shrink-0" />
      {/* h2, as BlogCard's title already is. The usecases index and the tag
          archives put these cards straight under the page's h1 with no
          section heading between, so an h3 skipped a level there. On the home
          page they still sit below the section's own h2, which a repeat of
          the same level does not break. The size comes from the classes, so
          the level carries no visual weight of its own. */}
      <h2 class="font-display text-lg font-bold text-foreground">{data.title}</h2>
    </div>

    <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1 text-center">{data.description}</p>

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap justify-center gap-1.5">
        {data.tags.map((tag) => (
          <span class="inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/40 transition-colors group-hover:ring-brand-500/80">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</Card>
