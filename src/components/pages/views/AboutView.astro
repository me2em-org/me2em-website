---
/**
 * AboutView — the About page body.
 *
 * Shared by the default-locale route (`/about`) and the locale-prefixed route
 * (`/<locale>/about`). All copy is read from the `pages.about.*` keys in the
 * locale dictionaries (`src/i18n/<locale>.json`) via `t()` / `tData()`, so
 * translating the page is a matter of editing JSON — no markup changes — and
 * any untranslated key falls back to the default locale automatically.
 *
 * Rendering with the default locale produces the same markup the page had
 * before this was extracted.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import { t, tData, defaultLocale } from '@/i18n';
import SandboxSeedIsland from '@/components/sandbox/SeedIsland';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{
  badge: string;
  titleLead: string;
  typingWords: string[];
  /** Shorter set for phones (below sm), dropping the one word wide enough to clip at the hero size. */
  typingWordsMobile: string[];
  description: string;
}>('pages.about.hero', locale)!;
const sandboxSeed = tData<{
  badge: string;
  heading: string;
  lead: string;
  ctaStart: string;
  generating: string;
  disclaimer: string;
  copied: string;
  verifyTitle: string;
  verifyRetry: string;
  bornTitle: string;
  bornText: string;
  nextLabel: string;
  nextHuman: string;
  nextIot: string;
  nextAgent: string;
  restart: string;
  panelHidden: string;
  panelRevealed: string;
  afterCopy: string;
  retryButton: string;
}>('pages.about.sandboxSeed', locale)!;
---
<PageLayout
  title={t('pages.about.meta.title', locale)}
  description={t('pages.about.meta.description', locale)}
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate pb-[var(--space-section-md)]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="rocket" size="sm" />
      {hero.badge}
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLead}</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] sm:hidden">
        <TypingEffect words={hero.typingWordsMobile} />
      </span>
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] hidden sm:inline">
        <TypingEffect words={hero.typingWords} />
      </span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <!-- Sandbox seed island -->
  <section class="py-[var(--space-section-md)] bg-background-secondary">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-eager data-reveal-ease="smooth">
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="sparkles" size="sm" />
            {sandboxSeed.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {sandboxSeed.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {sandboxSeed.lead}
        </p>
      </div>

      <SandboxSeedIsland client:load seed={sandboxSeed} />
    </div>
  </section>
</PageLayout>
