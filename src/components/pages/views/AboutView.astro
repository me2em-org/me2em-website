---
/**
 * AboutView — the About page for Me2eM.
 *
 * Shared by the default-locale route (`/about`) and the locale-prefixed route
 * (`/<locale>/about`). Page copy is read from `pages.about.*`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import { ABOUT_PAGE_SCHEMA } from '@/lib/schema';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string }>(
  'pages.about.hero',
  locale
)!;

const ctaChannels = tData('pages.about.cta.channels', locale) as Array<{ label: string; note: string; href: string }> | undefined;
---

<PageLayout
  title={tData('pages.about.meta.title', locale)}
  description={tData('pages.about.meta.description', locale)}
  eagerReveal
  extraSchemas={[ABOUT_PAGE_SCHEMA]}
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="sparkles" size="sm" />
      {hero.badge}
    </Badge>

    <h1 slot="title">
      {hero.titleLead} <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <!-- Brand Canon Section -->
  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div class="space-y-6" data-reveal>
          <h2 class="font-display text-2xl font-bold text-foreground">
            {t('pages.about.brand.title', locale)}
          </h2>
          <p class="text-foreground-muted">{t('pages.about.brand.description', locale)}</p>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-green-600 dark:text-green-400">Me2eM</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.prose', locale)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-green-600 dark:text-green-400">me2em</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.machine', locale)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="x" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-red-600 dark:text-red-400">Me2em</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.forbidden', locale)}</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex justify-center md:justify-end" data-reveal data-reveal-delay="1">
          <img
            src="/logo.png"
            alt={t('pages.about.brand.logo.alt', locale)}
            class="w-48 h-48 rounded-2xl object-contain bg-transparent"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Terms of Use -->
  <section class="relative isolate py-[var(--space-section-md)]">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="text-center mb-8" data-reveal>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {t('pages.about.terms.title', locale)}
        </h2>
      </div>
      <div class="max-w-3xl mx-auto" data-reveal data-reveal-delay="1">
        <Card class="p-8 space-y-4">
          <div class="flex items-start gap-3">
            <Icon name="shield" class="w-5 h-5 text-brand-500 mt-0.5 flex-shrink-0" />
            <div>
              <p class="text-sm font-semibold text-foreground">{t('pages.about.terms.logo.title', locale)}</p>
              <p class="text-sm text-foreground-muted mt-1">{t('pages.about.terms.logo.description', locale)}</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Strip -->
  <section class="relative isolate py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="text-center mb-6" data-reveal>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {t('pages.about.cta.title', locale)}
        </h2>
      </div>
      <div class="max-w-3xl mx-auto" data-reveal data-reveal-delay="1">
        <Card class="p-6 space-y-3">
          {ctaChannels?.map((ch) => (
            <a
              href={ch.href}
              {...(ch.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="block group"
            >
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                  <Icon name="arrow-up-right" size="sm" />
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-sm text-foreground">{ch.label}</p>
                  <p class="text-xs text-foreground-muted truncate">{ch.note}</p>
                </div>
                <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
              </div>
            </a>
          ))}
        </Card>
      </div>
      <div class="text-center mt-4" data-reveal data-reveal-delay="2">
        <a href="/community" class="text-sm text-brand-500 hover:underline">
          {t('pages.about.cta.more', locale)}
        </a>
      </div>
    </div>
  </section>
</PageLayout>
