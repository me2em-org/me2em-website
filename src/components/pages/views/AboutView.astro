---
/**
 * AboutView — the About page for Me2eM.
 *
 * Shared by the default-locale route (`/about`) and the locale-prefixed route
 * (`/<locale>/about`). Page copy is read from `pages.about.*`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import { getAuthorsMap } from '@/lib/authors';
import { t, tData, defaultLocale } from '@/i18n';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string }>(
  'pages.about.hero',
  locale
)!;

const authors = await getAuthorsMap();
const teamAuthor = authors.get('team');
---

<PageLayout
  title={tData('pages.about.meta.title', locale)}
  description={tData('pages.about.meta.description', locale)}
  eagerReveal
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="users" size="sm" />
      {hero.badge}
    </Badge>

    <h1 slot="title">
      {hero.titleLead} <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <!-- Brand Canon Section -->
  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div class="space-y-6" data-reveal>
          <h2 class="font-display text-2xl font-bold text-foreground">
            {t('pages.about.brand.title', locale)}
          </h2>
          <p class="text-foreground-muted">{t('pages.about.brand.description', locale)}</p>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-green-600 dark:text-green-400">Me2eM</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.prose', locale)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="check" class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-green-600 dark:text-green-400">me2em</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.machine', locale)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="x" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" />
              <div>
                <code class="font-mono font-semibold text-red-600 dark:text-red-400">Me2em</code>
                <p class="text-sm text-foreground-muted">{t('pages.about.brand.forbidden', locale)}</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex justify-center md:justify-end" data-reveal data-reveal-delay="1">
          <img
            src="/logo.png"
            alt={t('pages.about.brand.logo.alt', locale)}
            class="w-48 h-48 rounded-2xl object-contain bg-transparent"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Terms of Use -->
  <section class="relative isolate py-[var(--space-section-md)]">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="text-center mb-8" data-reveal>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {t('pages.about.terms.title', locale)}
        </h2>
      </div>
      <div class="max-w-3xl mx-auto" data-reveal data-reveal-delay="1">
        <Card class="p-8 space-y-4">
          <div class="flex items-start gap-3">
            <Icon name="shield" class="w-5 h-5 text-brand-500 mt-0.5 flex-shrink-0" />
            <div>
              <p class="text-sm font-semibold text-foreground">{t('pages.about.terms.logo.title', locale)}</p>
              <p class="text-sm text-foreground-muted mt-1">{t('pages.about.terms.logo.description', locale)}</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Expertise / Author Section -->
  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="text-center mb-8" data-reveal>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {t('pages.about.expertise.title', locale)}
        </h2>
        <p class="text-foreground-muted mt-2 max-w-2xl mx-auto">
          {t('pages.about.expertise.description', locale)}
        </p>
      </div>
      <div class="max-w-3xl mx-auto" data-reveal data-reveal-delay="1">
        {(() => {
          const author = teamAuthor;
          if (!author) return null;
          return (
            <Card class="p-8 text-center space-y-4">
              <a href="https://github.com/me2em-org/me2em-protocol" target="_blank" rel="noopener noreferrer">
                <img
                  src="/logo-outline.png"
                  alt={author.name}
                  class="w-20 h-20 mx-auto rounded-full object-contain ring-4 ring-brand-500"
                />
              </a>
              <h3 class="text-xl font-semibold text-foreground">{author.name}</h3>
              {author.bio && <p class="text-foreground-muted">{author.bio}</p>}
              <a href="https://github.com/SeLub" target="_blank" rel="noopener noreferrer" class="inline-block">
                <div class="flex -space-x-7">
                  <div class="w-10 h-10 rounded-full overflow-hidden bg-brand-500 text-white flex items-center justify-center ring-2 ring-background font-medium text-sm shrink-0">
                    A
                  </div>
                  <div class="w-10 h-10 rounded-full overflow-hidden bg-amber-500 text-white flex items-center justify-center ring-2 ring-background font-medium text-sm shrink-0">
                    B
                  </div>
                  <div class="w-10 h-10 rounded-full overflow-hidden bg-emerald-500 text-white flex items-center justify-center ring-2 ring-background font-medium text-sm shrink-0">
                    C
                  </div>
                  <img
                    src="https://avatars.githubusercontent.com/u/75365981?s=400&u=9753bae30d0f22b148465de5bc701fd291fa551a&v=4"
                    alt="Sergey Lubimov (SeLub)"
                    class="w-10 h-10 rounded-full object-cover ring-2 ring-background shrink-0"
                  />
                </div>
              </a>
            </Card>
          );
        })()}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="relative isolate py-[var(--space-section-md)]">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="text-center mb-8" data-reveal>
        <h2 class="font-display text-2xl font-bold text-foreground">
          {t('pages.about.faq.title', locale)}
        </h2>
      </div>

      <div class="space-y-3 max-w-3xl mx-auto" data-reveal data-reveal-delay="1">
        {(() => {
          const faqItems = tData('pages.about.faq.items', locale) as FAQItem[] | undefined;
          if (!Array.isArray(faqItems)) return null;
          return (
            <>
              {faqItems.map((item) => (
                <details class="group rounded-xl border border-border overflow-hidden">
                  <summary class="flex cursor-pointer items-center gap-3 px-5 py-4 font-semibold text-sm text-foreground hover:bg-secondary/50 transition-colors list-none [&::-webkit-details-marker]:hidden">
                    <Icon name="chevron-down" size="sm" class="shrink-0 text-foreground-muted group-open:rotate-180 transition-transform" />
                    {item.question}
                  </summary>
                  <div class="px-5 pb-4 pt-1 text-sm text-foreground-muted leading-relaxed" set:html={item.answer} />
                </details>
              ))}
            </>
          );
        })()}
      </div>
    </div>
  </section>
</PageLayout>
