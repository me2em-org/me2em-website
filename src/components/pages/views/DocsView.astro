---
/**
 * DocsView — the Docs page body.
 *
 * Shared by the default-locale route (`/docs`) and the locale-prefixed
 * route (`/<locale>/docs`). All copy is read from the `pages.docs.*`
 * keys in the locale dictionaries via `t()` / `tData()`; internal links are
 * built with `localizedPath` so they stay inside the active locale. Untranslated
 * keys fall back to the default locale.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import CtaBand from '@/components/patterns/CtaBand.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';
import { createFAQSchema } from '@/lib/schema';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

interface IncludedItem {
  lead: string;
  text: string;
}
interface Package {
  badge: string;
  heading: string;
  paragraphs: string[];
  included: IncludedItem[];
  ctaLabel: string;
}
interface ProcessStep {
  title: string;
  description: string;
}
interface FaqItem {
  question: string;
  answer: string;
}
interface FaqCard {
  icon: string;
  title: string;
  items: FaqItem[];
}
interface GlossaryTerm {
  term: string;
  definition: string;
}

const { locale = defaultLocale } = Astro.props;

const includedLabel = t('pages.docs.includedLabel', locale);
const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string; jumpLabels: string[] }>(
  'pages.docs.hero',
  locale
)!;
const design = tData<Package>('pages.docs.design', locale)!;
const development = tData<Package>('pages.docs.development', locale)!;
const performance = tData<Package>('pages.docs.performance', locale)!;
const glossary = tData<{ badge: string; heading: string; lead: string; terms: GlossaryTerm[] }>(
  'pages.docs.glossary',
  locale
)!;
const processSection = tData<{ badge: string; heading: string; lead: string; steps: ProcessStep[] }>(
  'pages.docs.process',
  locale
)!;
const faq = tData<{ badge: string; heading: string; lead: string; cards: FaqCard[] }>('pages.docs.faq', locale)!;

const faqSchema = faq.cards
  ? createFAQSchema(faq.cards.flatMap((c) => c.items.map(({ question, answer }) => ({ question, answer }))))
  : null;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string; tertiary: string }>(
  'pages.docs.cta',
  locale
)!;
const tutorials = tData<{ badge: string; headingLine1: string; headingLine2: string; para1: string; para2: string; casesIntro: string; moreTutorials: string }>(
  'pages.docs.tutorials',
  locale
)!;
const tutorialCases = tData<{ cases: { title: string; href: string }[] }>(
  'pages.home.tutorials',
  locale
)!;

const blogUrl = localizedPath('/blog', locale);
const tutorialsUrl = localizedPath( '/blog/tag/tutorial', locale)
const CORE_DOCS_URL = 'https://core.me2em.com';
const CRYPTO_DOCS_URL = 'https://crypto.me2em.com';
const REACT_DOCS_URL = 'https://react.me2em.com';
const NPM_ORG_URL = 'https://www.npmjs.com/org/me2em';
const GITHUB_URL = 'https://github.com/me2em-org/me2em-protocol';

// Tutorials teaser — four use-case cards. Titles and links live in i18n
// (tutorialCases.cases); icons are presentation and stay here.
const caseIcons = ['bot', 'radar', 'messages-square', 'plug-zap'] as const;
const caseCardBase =
  'bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 h-full';
const caseCardLinked = `${caseCardBase} hover:-translate-y-1 hover:shadow-md hover:border-brand-500`;
const caseCardIdle = `${caseCardBase} cursor-default`;
---
<PageLayout
  title={t('pages.docs.meta.title', locale)}
  description={t('pages.docs.meta.description', locale)}
  footerBackground="secondary"
  extraSchemas={faqSchema ? [faqSchema] : []}
>
  <Hero layout="centered" size="sm" class="isolate docs-hero pb-[calc(var(--space-section-sm)_+_var(--space-stack-lg))]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="sparkles" size="sm" />
      {hero.badge}
    </Badge>
    <h1 slot="title">
      <span class="text-foreground">{hero.titleLead}</span><br />
      <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description">
      {hero.description}
    </p>

    <Fragment slot="actions">
      <Button size="lg" href="#design" variant="outline">
        {hero.jumpLabels[0]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
      <Button size="lg" href="#development" variant="outline">
        {hero.jumpLabels[1]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
      <Button size="lg" href="#performance" variant="outline">
        {hero.jumpLabels[2]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Design -->
  <section id="design" class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="layout" size="sm" />
              {design.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {design.heading}
            </h2>
          </div>
          {design.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
          <Button variant="brand-outline" size="sm" class="self-start sm:self-center glitch:self-start mt-2 hidden sm:inline-flex glitch:inline-flex" href={CORE_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {design.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="layout" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {design.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
        <div class="flex justify-center sm:hidden glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" size="sm" href={CORE_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {design.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Development -->
  <section id="development" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:order-2 glitch:items-start glitch:text-left" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="code" size="sm" />
              {development.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {development.heading}
            </h2>
          </div>
          {development.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
          <Button variant="brand-outline" size="sm" class="self-start sm:self-center glitch:self-start mt-2 hidden sm:inline-flex glitch:inline-flex" href={CRYPTO_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {development.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:order-1 glitch:max-w-none glitch:mx-0" data-reveal data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="code" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {development.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
        <div class="flex justify-center sm:hidden glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" size="sm" href={CRYPTO_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {development.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance -->
  <section id="performance" class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="zap" size="sm" />
              {performance.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {performance.heading}
            </h2>
          </div>
          {performance.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
          <Button variant="brand-outline" size="sm" class="self-start sm:self-center glitch:self-start mt-2 hidden sm:inline-flex glitch:inline-flex" href={REACT_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {performance.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="zap" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {performance.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
        <div class="flex justify-center sm:hidden glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" size="sm" href={REACT_DOCS_URL} target="_blank" rel="noopener noreferrer">
            {performance.ctaLabel}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Glossary -->
  <section id="glossary" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="book-open" size="sm" />
            {glossary.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {glossary.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {glossary.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {glossary.terms.map((item, i) => (
          <Card variant="elevated" padding="md" data-reveal data-reveal-delay={i || undefined}>
            <h3 class="font-display text-base font-semibold text-foreground">{item.term}</h3>
            <p class="text-sm text-foreground-muted leading-relaxed mt-2">{item.definition}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Tutorials -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
        <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="book-open" size="sm" />
              {tutorials.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {tutorials.headingLine1}<br />
              <span class="text-brand-500">{tutorials.headingLine2}</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4 sm:mb-0 sm:max-w-xl glitch:mb-4 glitch:max-w-none">
            {tutorials.para1}
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8 sm:max-w-xl glitch:mb-8 glitch:max-w-none">
            {tutorials.para2}
          </p>
          <Button variant="brand-outline" href={tutorialsUrl} class="self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
            {tutorials.moreTutorials}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <p class="text-sm font-bold text-brand-500 mb-5 text-center sm:hidden glitch:block">{tutorials.casesIntro}</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 glitch:grid-cols-2 gap-3 flex-1 auto-rows-fr">
            {tutorialCases.cases.map((useCase, i) =>
              useCase.href ? (
                <a href={useCase.href} class={caseCardLinked}>
                  <Icon name={caseIcons[i]} class="w-10 h-10 text-brand-500" />
                  <p class="text-sm font-semibold text-foreground">{useCase.title}</p>
                </a>
              ) : (
                <div class={caseCardIdle}>
                  <Icon name={caseIcons[i]} class="w-10 h-10 text-brand-500" />
                  <p class="text-sm font-semibold text-foreground">{useCase.title}</p>
                </div>
              )
            )}
          </div>
        </Card>
        <div class="hidden sm:flex justify-center glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" href={blogUrl}>
            {tutorials.moreTutorials}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="list-checks" size="sm" />
            {processSection.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {processSection.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {processSection.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSection.steps.map((step, i) => (
          <ProofTile number={i + 1} title={step.title} data-reveal data-reveal-delay={i || undefined}>
            {step.description}
          </ProofTile>
        ))}
      </div>
    </div>
  </section>

  <!-- Questions & answers -->
  <section id="faq" class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="info" size="sm" />
            {faq.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {faq.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {faq.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {faq.cards.map((card, cardIndex) => (
          <Card variant="elevated" padding="lg" data-reveal data-reveal-delay={cardIndex + 1}>
            <div class="flex items-center gap-3 pb-4 border-b border-border">
              <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name={card.icon} size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{card.title}</h3>
            </div>
            <div class="w-full">
              {card.items.map((item) => (
                <details class="border-b border-border last:border-0" name={`docs-faq-${cardIndex}`}>
                  <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    {item.question}
                    <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
                  </summary>
                  <div class="pb-4 text-sm text-foreground-muted leading-relaxed" set:html={item.answer} />
                </details>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="#design">
          {cta.primary}
          <Icon name="rocket" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={NPM_ORG_URL} target="_blank" rel="noopener noreferrer">
          {cta.secondary}
          <Icon name="package" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          {cta.tertiary}
          <Icon name="github" size="sm" />
        </Button>
      </div>
    </CtaBand>
  </section>
</PageLayout>

<style is:global>
  /* FAQ accordion: rotate the chevron while an item is open. */
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }

  /* Gentle "scroll down" bounce on the hero jump-button arrows — same motion
      language as the homepage hero scroll indicator. */
  .docs-hero .hero-jump-arrow {
    animation: hero-jump-arrow-bounce 1.8s ease-in-out infinite;
  }
  @keyframes hero-jump-arrow-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-hero .hero-jump-arrow { animation: none; }
  }

  /* Page-local override: anchor links on /docs should land the
      section's coloured edge flush against the fixed header. */
  html { scroll-padding-top: 4rem; }
  @media (max-height: 600px) { html { scroll-padding-top: 4rem; } }
  @media (min-width: 1024px) { html { scroll-padding-top: 4rem; } }

  /* In-page anchor jumps (the hero section buttons) tag their destination —
     and everything above it — with .reveal-instant so the content is already
     in its final position when the smooth-scroll lands, instead of sliding in
     mid-jump. Natural scrolling is untouched and still animates. */
  .reveal-instant[data-reveal],
  .reveal-instant [data-reveal],
  .reveal-instant[data-reveal-children] > *,
  .reveal-instant [data-reveal-children] > * {
    opacity: 1;
    transform: none;
    transition: none;
  }
</style>

<script is:inline>
  /* When a hero section button is clicked — or the page is opened directly on
      one of those sections (e.g. /docs#development) — the destination (and
     everything the jump scrolls past) is snapped to its revealed state before
     the scroll lands, so cards don't slide in mid-jump. Sections below the
     target stay observed, so natural scrolling still animates normally. */
  (function () {
    function initDocsHeroJump() {
      const hero = document.querySelector('.docs-hero');
      if (!hero) return;
      const buttons = hero.querySelectorAll('a[href^="#"]');
      if (!buttons.length) return;

      function revealUpToAndIncluding(target) {
        const reveals = document.querySelectorAll('[data-reveal], [data-reveal-children]');
        Array.prototype.forEach.call(reveals, function (el) {
          const targetFollowsEl =
            el.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING;
          if (el === target || target.contains(el) || targetFollowsEl) {
            el.classList.add('reveal-instant', 'is-visible');
          }
        });
      }

      const targetIds = [];
      Array.prototype.forEach.call(buttons, function (btn) {
        const hash = btn.getAttribute('href');
        const id = hash ? hash.slice(1) : '';
        if (id) targetIds.push(id);
        btn.addEventListener('click', function () {
          const target = id && document.getElementById(id);
          if (target) revealUpToAndIncluding(target);
        });
      });

      const initialId = location.hash ? location.hash.slice(1) : '';
      if (initialId && targetIds.indexOf(initialId) !== -1) {
        const target = document.getElementById(initialId);
        if (target) revealUpToAndIncluding(target);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDocsHeroJump);
    } else {
      initDocsHeroJump();
    }
  })();
</script>
