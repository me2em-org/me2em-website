---
/**
 * HomeView — the landing page body.
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). All copy is read from `pages.home.*` via `t()` / `tData()`,
 * and internal links are localized with `localizedPath`. Featured usecases and
 * posts are loaded for the active locale and fall back to the default locale so
 * the sections are never empty on a locale that hasn't translated its content
 * yet. Each card links to the URL of the locale the content actually belongs
 * to, so a fallback (default-locale) item still points at a real page.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import CtaBand from '@/components/patterns/CtaBand.astro';
import StackMarquee from '@/components/landing/StackMarquee.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';
import { getPostUrl, getPublishedPosts } from '@/lib/blog';
import { getVisibleUsecases } from '@/lib/usecases';
import UsecaseCard from '@/components/usecases/UsecaseCard.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

interface UseCaseCard {
  title: string;
  /** Tutorial URL, locale-prefixed in the dictionary. Empty = no tutorial yet: renders a plain tile, not a link. */
  href: string;
}

const { locale = defaultLocale } = Astro.props;

// Featured usecases for this locale, falling back to the default locale so the
// section is never empty on a locale that hasn't translated its usecases yet.
let usecaseItems = await getVisibleUsecases(locale);
if (usecaseItems.length === 0 && locale !== defaultLocale) {
  usecaseItems = await getVisibleUsecases(defaultLocale);
}
const featuredUsecases = usecaseItems
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

let postItems = await getPublishedPosts(locale);
if (postItems.length === 0 && locale !== defaultLocale) {
  postItems = await getPublishedPosts(defaultLocale);
}
const posts = [...postItems]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 4);

// Hero marquee — a focused subset of the tech stack, in this order, pulled from
// the same `stack` collection so icons and links stay single-sourced. Six logos
// are wide enough to fill the constrained hero width and loop seamlessly on their
// own; the Tech-stack section further down still shows the full stack.
// Hero marquee — the cryptographic foundations, in protocol order:
// seed phrase → HKDF derivation → Ed25519/X25519 → Argon2id → language → repo.
const heroStackOrder = ['@scure/bip39', '@noble/hashes', '@noble/curves', 'hash-wasm', 'TypeScript', 'GitHub'];
const heroStackItems = (await getCollection('stack'))
  .filter((e) => heroStackOrder.includes(e.data.name))
  .sort((a, b) => heroStackOrder.indexOf(a.data.name) - heroStackOrder.indexOf(b.data.name))
  .map((e) => ({
    name: e.data.name,
    icon: e.data.icon,
    url: e.data.url,
    version: e.data.version,
    colorOklch: e.data.colorOklch,
  }));

const hero = tData<{
  badge: string;
  titleLine1: string;
  titleLine2: string;
  titleLine3: string;
  description: string;
  /** Shorter variant shown below the `sm` breakpoint so the hero stays compact on phones. */
  descriptionMobile: string;
  github: string;
  getStarted: string;
}>('pages.home.hero', locale)!;
const intro = tData<{ badge: string; heading: string; body: string }>('pages.home.intro', locale)!;
const workWithMe = tData<{ badge: string; heading: string; lead: string; cards: IconCard[]; cta: string }>(
  'pages.home.workWithMe',
  locale
)!;
const stackSection = tData<{ badge: string; heading: string; lead: string }>('pages.home.stack', locale)!;
const packagesSection = tData<{ badge: string; heading: string; lead: string; learnMore: string; cards: IconCard[] }>(
  'pages.home.packages',
  locale
)!;
const portfolio = tData<{ badge: string; heading: string; lead: string; viewAll: string }>('pages.home.portfolio', locale)!;
const testimonials = tData<{ badge: string; heading: string; lead: string; items: Testimonial[] }>(
  'pages.home.testimonials',
  locale
)!;
const tutorials = tData<{
  badge: string;
  headingLine1: string;
  headingLine2: string;
  para2: string;
  moreTutorials: string;
  casesIntro: string;
  cases: UseCaseCard[];
}>('pages.home.tutorials', locale)!;

// Tutorials teaser — four use-case cards. Titles and links live in i18n
// (tutorials.cases); icons are presentation and stay here. Index-paired:
// cases[i] renders with caseIcons[i]. An empty href renders a plain tile,
// so a missing tutorial never produces a link that 404s.
const caseIcons = ['bot', 'radar', 'messages-square', 'plug-zap'] as const;

const caseCardBase =
  'bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 h-full';
const caseCardLinked = `${caseCardBase} hover:-translate-y-1 hover:shadow-md hover:border-brand-500`;
const caseCardIdle = `${caseCardBase} cursor-default`;

const blogSection = tData<{ badge: string; heading: string; viewAll: string }>('pages.home.blog', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.home.cta',
  locale
)!;

const docsUrl = localizedPath('/docs', locale);
const useCasesUrl = localizedPath('/usecases', locale);
const blogUrl = localizedPath('/blog', locale);
const gitHubUrl = ('https://github.com/me2em-org/me2em-protocol');
// The hero "Get started" target is the documentation page at /docs. The donor
// getting-started post this pointed at is scheduled for deletion in BL-3
// and would 404.
const getStartedUrl = docsUrl;

const tutorialsPara1 = t('pages.home.tutorials.para1', locale);
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <!-- data-header-flip-anchor: the floating header keeps its over-the-hero
       look until this section is nearly out from under it. See the flip
       threshold in Header.astro.

       data-bar-color: Safari on iOS floats a translucent toolbar over the foot
       of the screen and tints it from the BODY's background. This hero is dark
       in both colour modes while the body under it is white in light mode,
       which draws a white strip across the foot of it. The theme script paints
       the body this colour while the hero covers that edge, and clears it
       after. Same value as --bar-color in global.css, which ends the hero's
       gradient. See `paintBody` in BaseLayout.astro. -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" fullHeight data-header-flip-anchor data-bar-color="#000">
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">{hero.badge}</Badge>

    {/* 12.6vw fills the mobile column (~95-98% at 320-390px), sized to the
        English demo strings — translated hero copy is the site owner's to
        refit. The 3rem cap keeps the size continuous with sm:text-5xl at
        the 640px boundary. */}
    <h1 slot="title" class="!text-[clamp(2rem,12.6vw,3rem)] sm:!text-5xl md:!text-6xl lg:!text-7xl">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor] whitespace-nowrap">{hero.titleLine1}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine2}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine3}</span>
    </h1>

    <p slot="description" class="!text-balance">
      <span class="sm:hidden">{hero.descriptionMobile}</span>
      <span class="hidden sm:inline">{hero.description}</span>
    </p>

   <Fragment slot="actions">
      <Button size="lg" href={gitHubUrl}>
        {hero.github}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={getStartedUrl}>
        <Icon name="rocket" size="sm" />
        {hero.getStarted}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>

    <!-- Tech-stack marquee floored into the hero in place of the scroll indicator:
         the content stays at the top and the marquee sits low near the bottom, with
         a roomy gap above it (a guaranteed minimum gap, so it never crowds the
         CTAs). Constrained to the content width; one decorative row; hidden on
         phones. cardWidth="auto" lets each card hug its logo + name so the logos sit
         close together; StackMarquee repeats the set to fill the row so the loop
         stays seamless. -->
    <div slot="bottom" class="mx-auto w-full max-w-6xl px-6">
      <!-- Tablet & up: the animated tech-stack marquee. -->
      <div class="hp-hero-marquee" aria-hidden="true">
        <StackMarquee items={heroStackItems} rows={1} duration={55} pauseOnHover={false} linked={false} cardWidth="auto" gap="1rem" />
      </div>
      <!-- Portrait phone: a static, non-animated row of the four core-stack logos.
           No marquee machinery — no duplicated track and no infinite animation — so
           there's zero ongoing compositor/battery cost on mobile. Logos only,
           non-interactive, with a one-time fade-in to match the marquee's entrance. -->
      <div class="hp-hero-logos" aria-hidden="true">
        {heroStackItems.slice(0, 4).map((item) => (
          <span class="hp-hero-logo">
            <Icon name={item.icon} size="lg" />
          </span>
        ))}
      </div>
    </div>
  </Hero>

  <!-- Protocol intro -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col items-center gap-6 text-center" data-reveal>
      <Badge variant="brand" pill>
        <Icon name="info" size="sm" />
        {intro.badge}
      </Badge>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">{intro.heading}</h2>
      <p class="text-lg text-foreground-muted leading-relaxed">{intro.body}</p>
    </div>
  </section>

  <!-- Packages Section -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="sparkles" size="sm" />
            {packagesSection.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {packagesSection.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          {packagesSection.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        {packagesSection.cards.map((card, i) => (
          <ProofTile
            href={docsUrl}
            icon={card.icon}
            title={card.title}
            data-reveal
            data-reveal-delay={i || undefined}
          >
            {card.description}
          </ProofTile>
        ))}
      </div>
    </div>
  </section>

  <!-- Work with me -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="handshake" size="sm" />
            {workWithMe.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {workWithMe.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {workWithMe.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {workWithMe.cards.map((card, i) => (
          <ProofTile icon={card.icon} title={card.title} data-reveal data-reveal-delay={i || undefined}>
            {card.description}
          </ProofTile>
        ))}
      </div>

      <div class="flex justify-center mt-4" data-reveal>
        <Button size="lg" href={docsUrl} class="cta-btn-brand">
          {workWithMe.cta}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>
          <Icon name="wrench" size="sm" />
          {stackSection.badge}
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">{stackSection.heading}</h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">{stackSection.lead}</p>
      </div>
      <StackMarquee />
    </div>
  </section>

  <!-- Portfolio -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="layers" size="sm" />
            {portfolio.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {portfolio.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          {portfolio.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {/* One card component for the homepage, the usecases index, the
            paginated pages and the tag archive. The homepage used to carry
            its own copy of this markup, so a change to the card reached three
            of the four places and quietly skipped this one. */}
        {featuredUsecases.map((usecase, i) => (
          <UsecaseCard usecase={usecase} index={i} locale={usecase.data.locale} />
        ))}
      </div>

      <div class="text-center mt-4">
        <Button variant="brand-outline" href={useCasesUrl}>
          {portfolio.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

<!-- About Teaser -->
<section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
      <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
        <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
          <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
            <Icon name="book-open" size="sm" />
            {tutorials.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {tutorials.headingLine1}<br />
            <span class="text-brand-500">{tutorials.headingLine2}</span>
          </h2>
        </div>
        <p class="text-lg text-foreground-muted leading-relaxed mb-4 sm:mb-0 sm:max-w-xl glitch:mb-4 glitch:max-w-none">
          {tutorialsPara1}
        </p>
        <p class="text-lg text-foreground-muted leading-relaxed mb-8 sm:max-w-xl glitch:max-w-none sm:hidden glitch:block">
          {tutorials.para2}
        </p>
        <Button variant="brand-outline" href={blogUrl} class="self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
          {tutorials.moreTutorials}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
      <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
        <p class="text-sm font-bold text-brand-500 mb-5 text-center sm:hidden glitch:block">{tutorials.casesIntro}</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 glitch:grid-cols-2 gap-3 flex-1 auto-rows-fr">
          {tutorials.cases.map((useCase, i) =>
            useCase.href ? (
              <a href={useCase.href} class={caseCardLinked}>
                <Icon name={caseIcons[i]} class="w-10 h-10 text-brand-500" />
                <p class="text-sm font-semibold text-foreground">{useCase.title}</p>
              </a>
            ) : (
              <div class={caseCardIdle}>
                <Icon name={caseIcons[i]} class="w-10 h-10 text-brand-500" />
                <p class="text-sm font-semibold text-foreground">{useCase.title}</p>
              </div>
            )
          )}
        </div>
      </Card>
      <div class="hidden sm:flex justify-center glitch:hidden" data-reveal data-reveal-delay="2">
        <Button variant="brand-outline" href={blogUrl}>
          {tutorials.moreTutorials}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </div>
</section>

 <!-- Testimonials -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="quote" size="sm" />
            {testimonials.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {testimonials.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted">
          {testimonials.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {testimonials.items.map((item, i) => (
          <Card variant="elevated" padding="lg" hover data-reveal data-reveal-delay={i || undefined}>
            <div class="flex flex-col h-full gap-4">
              <div class="flex gap-1 text-brand-500" role="img" aria-label="5 out of 5 stars">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <blockquote class="flex-1 text-foreground-muted leading-relaxed">
                {item.quote}
              </blockquote>
              <div class="flex items-center gap-3 pt-4 border-t border-border">
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-500/30 to-brand-500/10 flex items-center justify-center text-brand-500 font-bold text-sm shrink-0">
                  {item.name.charAt(0)}
                </div>
                <div>
                  <p class="text-sm font-semibold text-foreground">{item.name}</p>
                  <p class="text-xs text-foreground-muted">{item.role}</p>
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <Badge variant="brand" pill>
          <Icon name="book" size="sm" />
          {blogSection.badge}
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          {blogSection.heading}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={getPostUrl(post.id, post.data.locale)}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
            body={post.body}
            revealDelay={index}
            class={index === 3 ? 'hidden sm:block lg:hidden' : undefined}
          />
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="brand-outline" href={blogUrl}>
          {blogSection.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

 <!-- CTA — `secondary` so it alternates with the `background` Blog section above and the `background` Footer below. -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={docsUrl}>
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={gitHubUrl} target='_blank'>
          {cta.secondary}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </CtaBand>
  </section>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();
</script>

<style is:global>
