---
// src/components/ui/marketing/Logo/Logo.astro
/**
 * Logo Component
 *
 * Default: the Me2eM brand mark as inline SVG — a brand-coloured badge with
 * the Identity square at the centre and four Handle dots in the corners.
 * Inline is what makes the badge follow the active colour theme: an external
 * file rendered via <img> is in secure static mode and cannot see the page's
 * CSS variables, so it would be frozen at its authored colour.
 *
 * The per-author `letter` override (byline avatars) keeps the letter
 * monogram — author initials are not the brand mark.
 *
 * A legacy escape hatch remains: setting `branding.logo.image` in
 * site.config swaps the mark for a static <img> wherever no `letter` is
 * requested. The site does not use it — the inline mark is the one that
 * follows the theme.
 */
import { cn } from '@/lib/cn';
import siteConfig from '@/config/site.config';

interface Props {
  /** Size preset */
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Force dark mode logo (for dark backgrounds) — no-op here, kept for API compat */
  forceDark?: boolean;
  /** Use full logo instead of logomark — no-op here, kept for API compat */
  variant?: 'logomark' | 'full';
  /** Additional CSS classes */
  class?: string;
  /** Override the displayed letter (e.g. for author avatars). Defaults to first letter of site name. */
  letter?: string;
}

const {
  size = 'md',
  class: className,
  letter: letterProp,
} = Astro.props;

const sizeClasses: Record<string, { box: string; text: string; radius: string; img: string; px: number }> = {
  sm:    { box: 'w-5 h-5',   text: 'text-[14px]', radius: 'rounded-[4px]',  img: 'h-5 w-auto',  px: 20 },
  md:    { box: 'w-6 h-6',   text: 'text-[16px]', radius: 'rounded-[5px]',  img: 'h-6 w-auto',  px: 24 },
  lg:    { box: 'w-8 h-8',   text: 'text-[22px]', radius: 'rounded-[6px]',  img: 'h-8 w-auto',  px: 32 },
  xl:    { box: 'w-12 h-12', text: 'text-[34px]', radius: 'rounded-[8px]',  img: 'h-12 w-auto', px: 48 },
  '2xl': { box: 'w-24 h-24', text: 'text-[68px]', radius: 'rounded-[14px]', img: 'h-24 w-auto', px: 96 },
};

const { box, text, radius, img, px } = sizeClasses[size] ?? sizeClasses.md;

// Priority, inherited from the monogram component: a requested `letter`
// (byline avatar) wins over everything; a configured brand image wins over
// the default mark; otherwise the inline theme-following mark renders.
const logoImage = siteConfig.branding.logo.image;
const useImage = Boolean(logoImage) && !letterProp;
const letter = letterProp ?? siteConfig.name.charAt(0).toUpperCase();
---

{letterProp ? (
  <span
    class={cn(
      'inline-flex items-center justify-center shrink-0',
      'bg-brand-500 text-white',
      'font-display font-bold leading-none select-none',
      box, text, radius,
      className
    )}
    aria-label={siteConfig.branding.logo.alt}
    role="img"
  >
    {letter}
  </span>
) : useImage ? (
  <img
    src={logoImage}
    alt={siteConfig.branding.logo.alt}
    height={px}
    class={cn(
      'inline-block shrink-0 object-contain',
      img,
      className,
      'bg-transparent'
    )}
  />
) : (
  <svg
    viewBox="0 0 16 16"
    class={cn('inline-block shrink-0', box, className)}
    role="img"
    aria-label={siteConfig.branding.logo.alt}
  >
    <rect width="16" height="16" rx="3" class="fill-brand-500" />
    <rect x="6" y="6" width="4" height="4" fill="#fff" />
    <circle cx="3" cy="3" r="1.5" fill="#fff" />
    <circle cx="13" cy="3" r="1.5" fill="#fff" />
    <circle cx="3" cy="13" r="1.5" fill="#fff" />
    <circle cx="13" cy="13" r="1.5" fill="#fff" />
  </svg>
)}