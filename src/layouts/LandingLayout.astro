---
/**
 * LandingLayout
 * Layout wrapper for landing-style pages (marketing, demo, showcase)
 * Uses Header + Footer with landing-specific configuration
 *
 * This layout is part of the "demo" layer - it can be optionally installed
 * via CLI for users who want the full landing page experience.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  extraSchemas?: WithContext<Thing>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  extraSchemas = [],
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
  extraSchemas={extraSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="floating"
    variant="transparent"
    colorScheme="default"
    size="lg"
    showCta={false}
    cta={{ label: 'Me2eM Protocol', href: 'https://github.com/me2em-org/me2em-protocol', icon: 'rocket', trailingIcon: 'download' }}
    showThemeSelector
    autoHide={false}
    scrollProgressPosition="top"
    invertOnReturn={false}
  />

  <slot />

  <!-- Footer is `background` so it alternates with the `secondary` CTA section above it. -->
  <Footer slot="footer" layout="columns" background="default" />
</BaseLayout>
