---
import UsecasesTagView from '@/components/usecases/views/UsecasesTagView.astro';
import { defaultLocale } from '@/i18n';
import {
  PROJECT_TAG_CLOUD_LIMIT,
  collectUsecaseTags,
  collectTopUsecaseTags,
  getVisibleUsecases,
  tagToSlug,
} from '@/lib/usecases';

// Tag archive pages for the default locale. Additional locales are served by
// `src/pages/[locale]/usecases/tag/[tag].astro`, which renders the same view.
export async function getStaticPaths() {
  const usecases = await getVisibleUsecases(defaultLocale);
  const tags = collectUsecaseTags(usecases);
  const topTags = collectTopUsecaseTags(usecases, PROJECT_TAG_CLOUD_LIMIT);

  return tags.map((tag) => {
    const usecasesForTag = usecases.filter((p) => p.data.tags.includes(tag));
    // Keep the active tag in the cloud even when it's not popular enough to
    // make the top N, so the page always acknowledges the tag the user picked.
    const visibleTags = topTags.includes(tag)
      ? topTags
      : [tag, ...topTags.slice(0, PROJECT_TAG_CLOUD_LIMIT - 1)];
    return {
      params: { tag: tagToSlug(tag) },
      props: { tag, usecases: usecasesForTag, visibleTags },
    };
  });
}

const { tag, usecases, visibleTags } = Astro.props;
---

<UsecasesTagView locale={defaultLocale} tag={tag} usecases={usecases} visibleTags={visibleTags} />
