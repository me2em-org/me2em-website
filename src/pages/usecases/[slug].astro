---
import UsecaseLayout from '@/layouts/UsecaseLayout.astro';
import { render } from 'astro:content';
import { assertNoSlugCollisions } from '@/lib/content-validation';
import { getVisibleUsecases, getRoutableUsecases } from '@/lib/usecases';
import { defaultLocale } from '@/i18n';

export async function getStaticPaths() {
  // Fail the build early on content-integrity problems: two entries resolving
  // to the same URL within a locale.
  await assertNoSlugCollisions();

  const visibleUsecases = await getVisibleUsecases(defaultLocale);
  const routableUsecases = await getRoutableUsecases(defaultLocale);

  return routableUsecases.map((usecase) => ({
    params: { slug: usecase.id.replace(new RegExp(`^${defaultLocale}/`), '') },
    props: {
      usecase,
      related: visibleUsecases
        .filter((p) => p.id !== usecase.id)
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 3),
    },
  }));
}

const { usecase, related } = Astro.props;
const { Content, headings } = await render(usecase);
---

<UsecaseLayout
  title={usecase.data.title}
  description={usecase.data.description}
  meta={usecase.data.meta}
  url={usecase.data.url}
  repo={usecase.data.repo}
  image={usecase.data.image}
  imageAlt={usecase.data.imageAlt}
  gallery={usecase.data.gallery}
  tags={usecase.data.tags}
  slug={usecase.id}
  related={related}
  headings={headings}
  toc={usecase.data.toc}
>
  <Content />
</UsecaseLayout>
