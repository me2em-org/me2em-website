---
import { getSecondaryLocales } from '@/i18n';

// Locale-prefixed meta-refresh redirect from /<locale>/contact to /<locale>/community.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/{locale}/community" />
    <title>Community — Me2eM</title>
  </head>
  <body>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/{locale}/community" />
    </noscript>
  </body>
</html>
