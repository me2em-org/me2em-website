---
import UsecasesTagView from '@/components/usecases/views/UsecasesTagView.astro';
import {
  PROJECT_TAG_CLOUD_LIMIT,
  collectUsecaseTags,
  collectTopUsecaseTags,
  getVisibleUsecases,
  getSecondaryLocales,
  tagToSlug,
} from '@/lib/usecases';

// Locale-prefixed tag archives (`/<locale>/usecases/tag/<tag>`). One page per
// (non-default locale × tag that exists in that locale). Emits nothing when
// i18n is off.
export async function getStaticPaths() {
  const paths: {
    params: { locale: string; tag: string };
    props: {
      tag: string;
      usecases: Awaited<ReturnType<typeof getVisibleUsecases>>;
      visibleTags: string[];
    };
  }[] = [];

  for (const locale of getSecondaryLocales()) {
    const usecases = await getVisibleUsecases(locale);
    const tags = collectUsecaseTags(usecases);
    const topTags = collectTopUsecaseTags(usecases, PROJECT_TAG_CLOUD_LIMIT);

    for (const tag of tags) {
      const usecasesForTag = usecases.filter((p) => p.data.tags.includes(tag));
      const visibleTags = topTags.includes(tag)
        ? topTags
        : [tag, ...topTags.slice(0, PROJECT_TAG_CLOUD_LIMIT - 1)];
      paths.push({
        params: { locale, tag: tagToSlug(tag) },
        props: { tag, usecases: usecasesForTag, visibleTags },
      });
    }
  }

  return paths;
}

const { locale } = Astro.params;
const { tag, usecases, visibleTags } = Astro.props;
---

<UsecasesTagView locale={locale} tag={tag} usecases={usecases} visibleTags={visibleTags} />
