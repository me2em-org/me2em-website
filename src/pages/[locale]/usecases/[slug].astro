---
import UsecaseLayout from '@/layouts/UsecaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getUsecaseSlug, getSecondaryLocales, getVisibleUsecases, getRoutableUsecases } from '@/lib/usecases';

// Locale-prefixed usecases detail pages (`/<locale>/usecases/<slug>`). One page
// per (non-default locale × visible usecase in that locale). Emits nothing when
// i18n is off. The default-locale usecases are served by
// `src/pages/usecases/[slug].astro`, which also runs the build-time
// content-integrity guard across every locale, so it is not repeated here.
export async function getStaticPaths() {
  const paths: {
    params: { locale: string; slug: string };
    props: {
      usecase: Awaited<ReturnType<typeof getCollection<'usecases'>>>[number];
      related: Awaited<ReturnType<typeof getVisibleUsecases>>;
    };
  }[] = [];

  for (const locale of getSecondaryLocales()) {
    const visibleUsecases = await getVisibleUsecases(locale);
    const routableUsecases = await getRoutableUsecases(locale);

    for (const usecase of routableUsecases) {
      paths.push({
        params: { locale, slug: getUsecaseSlug(usecase.id, locale) },
        props: {
          usecase,
          related: visibleUsecases
            .filter((p) => p.id !== usecase.id)
            .sort((a, b) => a.data.order - b.data.order)
            .slice(0, 3),
        },
      });
    }
  }

  return paths;
}

const { usecase, related } = Astro.props;
const { Content, headings } = await render(usecase);
---

<UsecaseLayout
  title={usecase.data.title}
  description={usecase.data.description}
  meta={usecase.data.meta}
  url={usecase.data.url}
  repo={usecase.data.repo}
  image={usecase.data.image}
  imageAlt={usecase.data.imageAlt}
  gallery={usecase.data.gallery}
  tags={usecase.data.tags}
  slug={usecase.id}
  related={related}
  headings={headings}
  toc={usecase.data.toc}
>
  <Content />
</UsecaseLayout>
