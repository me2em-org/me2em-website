# Everything the build does not need, so the context stays small and a code
# edit does not invalidate the dependency layer.

# Git
.git
.github

# Dependencies and build output — reinstalled and rebuilt inside the image
node_modules/
dist/
.astro/
.vercel/
.netlify/
.wrangler/
public/pagefind/

# Docker's own files
Dockerfile
compose.yml
.dockerignore

# Secrets never belong in a build context
.env
.env.local
.env.*.local

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

# Misc
*.local
*.tsbuildinfo
package-lock.json
.claude/
